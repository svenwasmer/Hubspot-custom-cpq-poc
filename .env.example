# Service key / private app token with the `content` scope
HUBSPOT_ACCESS_TOKEN=replace_me
# Path of the uploaded coded template (no leading slash)
HUBSPOT_TEMPLATE_PATH=cpq-poc/templates/quote.html
# Optional: landing page domain (blank = account's primary landing page domain)
HUBSPOT_DOMAIN=
# Where expired quote pages redirect to
EXPIRY_REDIRECT_URL=https://www.example.com
# Days until a quote page expires
QUOTE_EXPIRY_DAYS=30
# Seconds ahead to schedule publishing (the API rejects "now")
PUBLISH_LEAD_SECONDS=3
PORT=3000
